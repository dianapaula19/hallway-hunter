# PostHog
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# Our own inbox: the only address approved drafts are written to (outbox rows, status 'draft'; nothing is ever sent),
# and what a page's "Reply yes" button opens a mail to. Copy this file to .env.local and put a real team address here.
# Left unset, or left as this .example placeholder, drafts go to hallway-hunter-team@localhost and /p shows no
# "Reply yes" button, only a note saying what it would do.
HH_OWN_INBOX=your-team@velho.example
